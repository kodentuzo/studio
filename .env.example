# Copy to .env. These values match compose.yaml and are for development only.
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/postgres
REGISTRY_URL=http://localhost:5001
# Signs sessions. Make your own: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The address Studio is reached at.
BETTER_AUTH_URL=http://localhost:5173
# Optional: the folder uploaded files are kept in. The default is data/files.
# FILES_DIR=data/files
# Optional: a model server for reading PDF invoices into transactions. Leave it out for none.
# For the local one: pnpm ai:up, then uncomment the next line.
# AI_URL=http://localhost:11434
# AI_MODEL=granite3.3:2b
